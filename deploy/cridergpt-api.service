[Unit]
Description=CriderGPT Native Inference API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=cridergpt
Group=cridergpt
WorkingDirectory=/opt/cridergpt-engine
EnvironmentFile=-/etc/cridergpt/cridergpt-api.env
ExecStart=/opt/cridergpt-engine/.venv/bin/python -m uvicorn cridergpt_api.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
